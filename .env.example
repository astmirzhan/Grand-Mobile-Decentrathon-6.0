# Copy to .env (never commit it). Only needed for LLM checks; `locqa check --no-llm` needs no keys.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Model: gpt-5.4, gemini-*, or ollama/<model>
LOCQA_MODEL=gpt-5.4
# Reasoning depth for reasoning models (default: low)
LOCQA_EFFORT=low
# 1 = answer only from the local cache, no API calls
LOCQA_OFFLINE=0
# Reuse cached answers of other models, e.g. ensemble:low,ollama/gemma3:27b:low
LOCQA_FALLBACK_CACHE=
# Parallelism and batch size for `locqa check`
LOCQA_WORKERS=
LOCQA_BATCH=
# Custom price in $ per 1M tokens: in,out,cached
LOCQA_PRICE=
# Local Ollama server (context window must be > 4096, see ollama/Modelfile)
OLLAMA_BASE_URL=http://localhost:11434
